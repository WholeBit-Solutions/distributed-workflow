@ContentType = application/json
@BaseUrl = http://localhost:5009
# Variables to store IDs for cross-controller testing
@PersonId = 0
@ContactId = 0
@AddressId = 0

################################################################################
# SECTION 1: BASIC WORKFLOW - CREATE ENTIRE ENTITY CHAIN
################################################################################

### WORKFLOW 1.1: Create a Person
POST {{BaseUrl}}/people
Content-Type: {{ContentType}}

{
  "firstName": "Alice",
  "lastName": "Johnson",
  "dateOfBirth": "1990-03-15"
}

###

### WORKFLOW 1.2: Create Contact for Person (PersonId: 1)
POST {{BaseUrl}}/contact?personId=1
Content-Type: {{ContentType}}

{
  "email": "alice.johnson@example.com",
  "phone": "555-0100"
}
###

### WORKFLOW 1.3: Create Address for Contact (ContactInfoId: 1)
POST {{BaseUrl}}/address?contactInfoId=1
Content-Type: {{ContentType}}

{
  "street": "100 Main Street",
  "city": "Boston",
  "state": "MA",
  "postalCode": "02101",
  "country": "USA",
  "addressType": 1
}

###

### WORKFLOW 1.4: Read the Person we created
GET {{BaseUrl}}/people/1
Accept: {{ContentType}}

###

### WORKFLOW 1.5: Read the Contact we created
GET {{BaseUrl}}/contact/1
Accept: {{ContentType}}

###

### WORKFLOW 1.6: Read the Address we created
GET {{BaseUrl}}/address/1
Accept: {{ContentType}}

###

################################################################################
# SECTION 2: VERIFY RELATIONSHIPS - ONE PERSON, MULTIPLE CONTACTS
################################################################################

### WORKFLOW 2.1: Create second Contact for same Person (PersonId: 1)
POST {{BaseUrl}}/contact/1
Content-Type: {{ContentType}}

{
  "email": "alice.personal@example.com",
  "phone": "555-0101",
  "type": 2
}

###

### WORKFLOW 2.2: Create Address for second Contact (ContactInfoId: 2)
POST {{BaseUrl}}/address/2
Content-Type: {{ContentType}}

{
  "street": "200 Oak Avenue",
  "city": "Cambridge",
  "state": "MA",
  "postalCode": "02138",
  "country": "USA",
  "addressType": 2,
  "contactInfoId": 2
}

###

### WORKFLOW 2.3: Create third Contact for same Person (PersonId: 1)
POST {{BaseUrl}}/contact/1
Content-Type: {{ContentType}}

{
  "email": "alice.alternate@example.com",
  "phone": "555-0102",
  "personId": 1
}

###

### WORKFLOW 2.4: Create Address for third Contact (ContactInfoId: 3)
POST {{BaseUrl}}/address/3
Content-Type: {{ContentType}}

{
  "street": "300 Pine Road",
  "city": "Somerville",
  "state": "MA",
  "postalCode": "02144",
  "country": "USA",
  "addressType": 3,
  "contactInfoId": 3
}

###

### WORKFLOW 2.5: Get all contacts to see they belong to Person 1
GET {{BaseUrl}}/contact
Accept: {{ContentType}}

###

### WORKFLOW 2.6: Get all addresses to see relationships
GET {{BaseUrl}}/address
Accept: {{ContentType}}

###

################################################################################
# SECTION 3: VERIFY CASCADING UPDATES
################################################################################

### WORKFLOW 3.1: Update the Person (Alice → Alicia)
PUT {{BaseUrl}}/people
Content-Type: {{ContentType}}

{
  "id": 1,
  "firstName": "Alicia",
  "lastName": "Johnson",
  "dateOfBirth": "1990-03-15"
}

###

### WORKFLOW 3.2: Verify Person was updated
GET {{BaseUrl}}/people/1
Accept: {{ContentType}}

###

### WORKFLOW 3.3: Update Contact for this Person
PUT {{BaseUrl}}/contact
Content-Type: {{ContentType}}

{
  "id": 1,
  "email": "alicia.johnson@example.com",
  "phone": "555-0100",
  "personId": 1
}

###

### WORKFLOW 3.4: Verify Contact was updated
GET {{BaseUrl}}/contact/1
Accept: {{ContentType}}

###

### WORKFLOW 3.5: Update Address for this Contact
PUT {{BaseUrl}}/address
Content-Type: {{ContentType}}

{
  "id": 1,
  "street": "100 Main Street, Suite 100",
  "city": "Boston",
  "state": "MA",
  "postalCode": "02101",
  "country": "USA",
  "addressType": 1,
  "contactInfoId": 1
}

###

### WORKFLOW 3.6: Verify Address was updated
GET {{BaseUrl}}/address/1
Accept: {{ContentType}}

###

