################################################################################
# SECTION 5: CROSS-CONTROLLER VERIFICATION
################################################################################

### VERIFY 5.1: Get Person 1 and verify it has multiple contacts
GET {{BaseUrl}}/people/1
Accept: {{ContentType}}

###

### VERIFY 5.2: Get all contacts (should show contacts from all persons)
GET {{BaseUrl}}/contact
Accept: {{ContentType}}

###

### VERIFY 5.3: Get Contact 1 and verify it belongs to Person 1
GET {{BaseUrl}}/contact/1
Accept: {{ContentType}}

###

### VERIFY 5.4: Get all addresses (should show addresses from all contacts)
GET {{BaseUrl}}/address
Accept: {{ContentType}}

###

### VERIFY 5.5: Get Address 1 and verify it belongs to Contact 1
GET {{BaseUrl}}/address/1
Accept: {{ContentType}}

###

################################################################################
# SECTION 6: CASCADING DELETES (Delete in correct order)
################################################################################

### DELETE 6.1: Delete Address first (Contact still exists)
DELETE {{BaseUrl}}/address/1
Accept: {{ContentType}}

###

### DELETE 6.2: Verify Address is deleted
GET {{BaseUrl}}/address/1
Accept: {{ContentType}}

###

### DELETE 6.3: Delete Contact (Person still exists)
DELETE {{BaseUrl}}/contact/1
Accept: {{ContentType}}

###

### DELETE 6.4: Verify Contact is deleted
GET {{BaseUrl}}/contact/1
Accept: {{ContentType}}

###

### DELETE 6.5: Delete Person
DELETE {{BaseUrl}}/people/1
Accept: {{ContentType}}

###

### DELETE 6.6: Verify Person is deleted
GET {{BaseUrl}}/people/1
Accept: {{ContentType}}

###

################################################################################
# SECTION 7: VERIFY REMAINING DATA AFTER DELETIONS
################################################################################

### VERIFY 7.1: Get all people (should have 2 remaining)
GET {{BaseUrl}}/people
Accept: {{ContentType}}

###

### VERIFY 7.2: Get all contacts (should have contacts from remaining people)
GET {{BaseUrl}}/contact
Accept: {{ContentType}}

###

### VERIFY 7.3: Get all addresses (should have addresses from remaining contacts)
GET {{BaseUrl}}/address
Accept: {{ContentType}}

###

################################################################################
# SECTION 8: ERROR SCENARIOS - INVALID FOREIGN KEY RELATIONSHIPS
################################################################################

### ERROR 8.1: Try to create Contact with non-existent PersonId (should fail)
POST {{BaseUrl}}/contact
Content-Type: {{ContentType}}

{
  "email": "test@example.com",
  "phone": "555-9999",
  "personId": 99999
}

###

### ERROR 8.2: Try to create Address with non-existent ContactInfoId (should fail)
POST {{BaseUrl}}/address
Content-Type: {{ContentType}}

{
  "street": "999 Test Street",
  "city": "Test City",
  "state": "TC",
  "postalCode": "00000",
  "contactInfoId": 99999
}

###

### ERROR 8.3: Try to update Contact with non-existent PersonId (should fail)
PUT {{BaseUrl}}/contact
Content-Type: {{ContentType}}

{
  "id": 2,
  "email": "test@example.com",
  "phone": "555-9999",
  "personId": 99999
}

###

### ERROR 8.4: Try to update Address with non-existent ContactInfoId (should fail)
PUT {{BaseUrl}}/address
Content-Type: {{ContentType}}

{
  "id": 2,
  "street": "999 Test Street",
  "city": "Test City",
  "state": "TC",
  "postalCode": "00000",
  "contactInfoId": 99999
}

###

