@KafkaWorkflow.WebApi_HostAddress = http://localhost:5009
@ContentType = application/json

################################################################################
# PEOPLE CONTROLLER ENDPOINTS
################################################################################

### GET all people
GET {{KafkaWorkflow.WebApi_HostAddress}}/people
Accept: {{ContentType}}

###

### POST create new person
POST {{KafkaWorkflow.WebApi_HostAddress}}/people
Content-Type: {{ContentType}}

{
  "firstName": "John12",
  "lastName": "Doe"
}

###

### PUT update existing person
PUT {{KafkaWorkflow.WebApi_HostAddress}}/people
Content-Type: {{ContentType}}

{
  "id": 1001,
  "firstName": "John",
  "lastName": "Smith"
}

###

### DELETE person by ID
DELETE {{KafkaWorkflow.WebApi_HostAddress}}/people/1001
Accept: {{ContentType}}

###

################################################################################
# ADDRESS CONTROLLER ENDPOINTS
################################################################################

### GET all addresses
GET {{KafkaWorkflow.WebApi_HostAddress}}/address
Accept: {{ContentType}}

###

### POST create new address
POST {{KafkaWorkflow.WebApi_HostAddress}}/address
Content-Type: {{ContentType}}

{
  "street": "123 Main Street",
  "city": "Boston",
  "state": "MA",
  "postalCode": "02101",
  "contactInfoId": 1
}

###

### PUT update existing address
PUT {{KafkaWorkflow.WebApi_HostAddress}}/address
Content-Type: {{ContentType}}

{
  "id": 2001,
  "street": "456 Oak Avenue",
  "city": "Boston",
  "state": "MA",
  "postalCode": "02102",
  "contactInfoId": 1
}

###

### DELETE address by ID
DELETE {{KafkaWorkflow.WebApi_HostAddress}}/address/2001
Accept: {{ContentType}}

###

################################################################################
# CONTACT CONTROLLER ENDPOINTS
################################################################################

### GET all contacts
GET {{KafkaWorkflow.WebApi_HostAddress}}/contact
Accept: {{ContentType}}

###

### POST create new contact
POST {{KafkaWorkflow.WebApi_HostAddress}}/contact
Content-Type: {{ContentType}}

{
  "email": "john.doe@example.com",
  "phone": "555-0100"
}

###

### PUT update existing contact
PUT {{KafkaWorkflow.WebApi_HostAddress}}/contact
Content-Type: {{ContentType}}

{
  "id": 3001,
  "email": "john.smith@example.com",
  "phone": "555-0101"
}

###

### DELETE contact by ID
DELETE {{KafkaWorkflow.WebApi_HostAddress}}/contact/3001
Accept: {{ContentType}}

###

################################################################################
# WORKFLOW EXAMPLES
################################################################################

### Workflow: Create person
POST {{KafkaWorkflow.WebApi_HostAddress}}/people
Content-Type: {{ContentType}}

{
  "firstName": "Jane",
  "lastName": "Wilson",
  "age": 28
}

###

### Workflow: Create contact for person
POST {{KafkaWorkflow.WebApi_HostAddress}}/contact
Content-Type: {{ContentType}}

{
  "email": "jane.wilson@example.com",
  "phone": "555-0200"
}

###

### Workflow: Create address for contact
POST {{KafkaWorkflow.WebApi_HostAddress}}/address
Content-Type: {{ContentType}}

{
  "street": "789 Pine Road",
  "city": "Cambridge",
  "state": "MA",
  "postalCode": "02138",
  "contactInfoId": 3002
}

###

################################################################################
# BULK OPERATIONS
################################################################################

### Create multiple people
POST {{KafkaWorkflow.WebApi_HostAddress}}/people
Content-Type: {{ContentType}}

{
  "firstName": "Robert",
  "lastName": "Johnson"
}

###

### Create another person
POST {{KafkaWorkflow.WebApi_HostAddress}}/people
Content-Type: {{ContentType}}

{
  "firstName": "Sarah",
  "lastName": "Williams"
}

###

### Create another person
POST {{KafkaWorkflow.WebApi_HostAddress}}/people
Content-Type: {{ContentType}}

{
  "firstName": "Michael",
  "lastName": "Brown"
}

###

################################################################################
# ERROR HANDLING EXAMPLES
################################################################################

### Try to get non-existent person (should return 404)
GET {{KafkaWorkflow.WebApi_HostAddress}}/people/99999
Accept: {{ContentType}}

###

### Try to delete non-existent address (should return 404)
DELETE {{KafkaWorkflow.WebApi_HostAddress}}/address/99999
Accept: {{ContentType}}

###

### Try to delete non-existent contact (should return 404)
DELETE {{KafkaWorkflow.WebApi_HostAddress}}/contact/99999
Accept: {{ContentType}}

###

